    <style>:root {
	font-family: Segoe UI, Arial, sans-serif;
	color: #182c35;
	background: #f3f5f4;
	font-size: 15px
}

* {
	box-sizing: border-box
}

body {
	margin: 0
}

button, input, select {
	font: inherit
}

button, .file-button {
	min-height: 42px;
	border: 1px solid #cdd9d6;
	background: white;
	border-radius: 9px;
	padding: 9px 13px;
	cursor: pointer;
	color: #243c43
}

button:hover, .file-button:hover {
	background: #edf5f1;
	border-color: #6ca591
}

button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible {
	outline: 3px solid #e69d30;
	outline-offset: 2px
}

button:disabled {
	opacity: .45;
	cursor: default
}

.primary {
	background: #166d59;
	color: white;
	border-color: #166d59
}

.primary:hover {
	background: #115442;
	color: white
}

header {
	padding: 20px 28px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 20px;
	background: white;
	border-bottom: 1px solid #dce4df
}

h1 {
	font-size: 24px;
	letter-spacing: -.7px;
	margin: 0
}

h1 span {
	color: #16866b
}

header p {
	margin: 5px 0 0;
	color: #65767b;
	font-size: 13px
}

.actions {
	display: flex;
	gap: 8px;
	flex-wrap: wrap
}

.badge {
	font-size: 11px;
	letter-spacing: 1.3px;
	text-transform: uppercase;
	color: #617a72
}

.toolbar {
	display: flex;
	align-items: center;
	gap: 12px;
	padding: 12px 28px;
	border-bottom: 1px solid #dce4df;
	flex-wrap: wrap
}

.toolbar .status {
	flex: 1;
	color: #52676d;
	font-size: 13px
}

main {
	display: grid;
	grid-template-columns: 325px 290px minmax(300px,1fr);
	height: calc(100vh - 157px);
	min-height: 580px
}

.panel {
	border-right: 1px solid #dce4df;
	background: #fff;
	overflow: auto;
	padding: 21px 18px
}

.panel h2 {
	font-size: 16px;
	margin: 0 0 6px
}

.muted {
	color: #6e7e82;
	font-size: 13px;
	line-height: 1.5
}

.search {
	width: 100%;
	padding: 11px;
	border: 1px solid #ccd8d2;
	border-radius: 8px;
	margin: 14px 0 10px
}

.field {
	display: flex;
	width: 100%;
	align-items: center;
	gap: 10px;
	text-align: left;
	border: 1px solid transparent;
	border-radius: 8px;
	margin: 3px 0;
	padding: 11px 10px
}

.field.active {
	background: #e7f2ed;
	border-color: #acd0bd
}

.field .dot {
	width: 9px;
	height: 9px;
	border-radius: 50%;
	background: #27856b;
	flex: none
}

.field.off .dot {
	background: #bec9c5
}

.field.off {
	color: #7e8b88
}

.field strong {
	display: block;
	font-size: 14px;
	font-weight: 600
}

.field small {
	display: block;
	font-size: 11px;
	color: #6e7e82;
	overflow-wrap: anywhere;
	margin-top: 3px
}

.field .count {
	margin-left: auto;
	font-size: 11px;
	color: #85918d
}

.section {
	margin-top: 23px;
	padding-top: 20px;
	border-top: 1px solid #e6ebe8
}

label.control {
	display: block;
	margin: 16px 0 6px;
	font-size: 13px;
	font-weight: 600
}

input[type=number], select {
	width: 100%;
	padding: 10px;
	border: 1px solid #ccd8d2;
	border-radius: 8px;
	background: white
}

input[type=color] {
	width: 49px;
	height: 42px;
	padding: 4px;
	border: 1px solid #ccd8d2;
	border-radius: 8px;
	background: white
}

.row {
	display: flex;
	gap: 8px;
	align-items: center
}

.row>* {
	flex: 1
}

.row input[type=color] {
	flex: 0 0 49px
}

.toggle {
	display: flex;
	align-items: center;
	gap: 9px;
	min-height: 42px;
	font-size: 14px
}

.toggle input {
	width: 19px;
	height: 19px;
	accent-color: #166d59
}

.formats {
	display: flex;
	gap: 7px
}

.formats button {
	flex: 1;
	font-size: 18px
}

.formats button[aria-pressed=true] {
	background: #166d59;
	color: white
}

.preview-area {
	padding: 22px;
	display: flex;
	flex-direction: column;
	min-width: 0;
	overflow: hidden
}

.preview-head {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	margin-bottom: 15px
}

.preview-head h2 {
	font-size: 16px;
	margin: 0
}

.preview-head p {
	margin: 4px 0 0
}

.preview-shell {
	flex: 1;
	min-height: 200px;
	background: #fff;
	border: 1px solid #d5e0d9;
	border-radius: 12px;
	overflow: hidden;
	box-shadow: 0 8px 30px #1b3f3210
}

iframe {
	border: 0;
	width: 100%;
	height: 100%;
	background: white
}

.empty {
	display: flex;
	min-height: 100%;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	text-align: center;
	padding: 30px
}

.empty .icon {
	font-size: 40px;
	color: #16866b;
	margin-bottom: 15px
}

.empty h2 {
	font-size: 25px;
	margin: 0 0 8px
}

.empty p {
	max-width: 420px;
	line-height: 1.6;
	color: #6e7e82
}

.empty .actions {
	justify-content: center;
	margin-top: 15px
}

details summary {
	cursor: pointer;
	min-height: 40px;
	padding: 10px 0;
	font-size: 13px;
	font-weight: 600
}

.pager {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 12px;
	margin-top: 13px;
	font-size: 13px
}

.pager button {
	min-height: 35px;
	padding: 5px 12px
}

#message {
	padding: 11px 28px;
	background: #fff0cb;
	border-bottom: 1px solid #e9d69d;
	font-size: 14px;
	line-height: 1.5
}

#message[hidden] {
	display: none
}

.hint {
	background: #eef5f1;
	padding: 11px;
	border-radius: 8px;
	font-size: 12px;
	line-height: 1.6;
	color: #4c6860
}

.editor-title {
	overflow-wrap: anywhere
}

#dropOverlay {
	position: fixed;
	inset: 0;
	z-index: 10;
	display: grid;
	place-items: center;
	background: #e3f3ebee;
	border: 5px dashed #16866b;
	font-size: 30px;
	pointer-events: none
}

#dropOverlay[hidden] {
	display: none
}

dialog {
	border: 0;
	border-radius: 14px;
	padding: 25px;
	max-width: 580px;
	width: 90%;
	box-shadow: 0 20px 80px #0004
}

dialog::backdrop {
	background: #15332b77
}

dialog p {
	line-height: 1.6
}

dialog code {
	display: block;
	background: #edf2ef;
	padding: 15px;
	white-space: pre-wrap;
	overflow-wrap: anywhere
}

footer {
	font-size: 12px;
	color: #6e7e82;
	margin-top: 15px
}

@media(max-width:1100px) {
main {
	grid-template-columns: 255px 250px minmax(280px,1fr)
}

header {
	padding: 16px
}

.toolbar {
	padding: 10px 16px
}

.panel {
	padding: 16px 12px
}

.preview-area {
	padding: 15px
}

}

@media(max-width:800px) {
header {
	align-items: flex-start;
	flex-direction: column
}

main {
	height: auto;
	grid-template-columns: 1fr 1fr;
	min-height: 0
}

.panel {
	max-height: 600px
}

.preview-area {
	grid-column: 1/-1;
	height: 650px
}

.toolbar {
	gap: 8px
}

.actions button {
	font-size: 13px
}

}

.field>span:nth-child(2) {
	min-width: 0;
	flex: 1
}

.field strong {
	overflow-wrap: anywhere
}

.app-credit {
	margin: 0;
	padding: 12px 24px;
	text-align: center;
	background: #fff;
	border-top: 1px solid #dce4df;
	color: #52676d
}

.app-credit a {
	color: #166d59;
	font-weight: 600;
	text-underline-offset: 3px
}

.header-credit a {
	color: #166d59;
	font-weight: 600;
	text-underline-offset: 3px
}

.header-credit a:hover {
	color: #0c493b
}

#coffee {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-width: 44px;
	padding: 7px;
	background: #f1f3f2
}

#coffee:hover {
	background: #dce9e2
}

#coffee img {
	display: block;
	object-fit: contain
}

#coffeeDialog {
	width: min(420px,calc(100vw - 30px));
	max-height: calc(100vh - 30px);
	overflow: auto;
	background: #fff;
	color: #000;
	border: 1px solid #cdd9d6;
	border-radius: 8px;
	padding: 22px;
	text-align: center
}

#coffeeDialog::backdrop {
	background: rgba(0,0,0,.72)
}

#coffeeDialog h2 {
	margin-top: 0;
	color: #166d59;
	font-size: 22px
}

#coffeeDialog p {
	line-height: 1.45
}

#coffeeDialog .payment-qr {
	display: block;
	width: 240px;
	max-width: 100%;
	height: auto;
	margin: 16px auto
}

#coffeeDialog button {
	margin-top: 5px;
	background: #166d59;
	border-color: #166d59;
	color: #fff
}

#coffeeDialog button:hover {
	background: #115442
}

.brand-row {
	display: flex;
	align-items: center;
	gap: 24px;
	margin: 4px 0
}

.brand-row h1 {
	line-height: 0
}

.brand-logo {
	display: block;
	width: 100px;
	height: auto
}

.brand-row #coffee {
	border-color: #8fba9f
}

.brand h1 {
	line-height: 0;
	margin: 0
}

.brand .brand-logo {
	width: 130px;
	height: auto
}

.header-credit {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	column-gap: 36px;
	row-gap: 12px;
	margin-top: 16px;
	color: #65767b;
	font-size: 15px
}

.author-group {
	display: flex;
	align-items: center;
	gap: 14px
}

.author-avatar {
	display: block;
	width: 44px;
	height: 44px;
	object-fit: contain
}

.assistant-credit {
	white-space: nowrap
}

.author-group #coffee {
	border-color: #8fba9f;
	width: 46px;
	height: 46px;
	padding: 7px
}

header>.actions {
	flex-shrink: 0
}

@media(max-width:1000px) {
header {
	flex-wrap: wrap;
	gap: 16px
}

.header-credit {
	column-gap: 22px
}

}

header {
	display: grid;
	grid-template-columns: auto minmax(0,1fr) auto;
	align-items: end;
	gap: 20px;
	padding: 16px 24px
}

.brand .brand-logo {
	width: 145px
}

.header-credit {
	margin: 0;
	align-self: center;
	justify-content: center;
	column-gap: 20px;
	row-gap: 8px
}

header>.actions {
	align-self: end;
	justify-content: flex-end;
	flex-wrap: nowrap
}

header>.actions button {
	white-space: nowrap
}

@media(max-width:1150px) {
header {
	gap: 14px;
	padding: 14px 16px
}

.brand .brand-logo {
	width: 130px
}

.header-credit {
	font-size: 14px;
	column-gap: 14px
}

.author-group {
	gap: 10px
}

header>.actions {
	gap: 6px
}

header>.actions button {
	font-size: 14px;
	padding: 9px 10px
}

}

@media(max-width:950px) {
header {
	gap: 12px
}

.brand .brand-logo {
	width: 115px
}

.header-credit {
	flex-direction: column;
	align-items: center;
	gap: 6px
}

.author-avatar {
	width: 36px;
	height: 36px
}

.author-group #coffee {
	width: 40px;
	height: 40px;
	min-height: 40px;
	min-width: 40px;
	padding: 5px
}

}

@media(max-width:720px) {
header {
	grid-template-columns: auto minmax(0,1fr);
