$('openSettings').onclick=()=>{if(!xml){tell('Nejdřív načtěte XML, potom jeho uložený vzhled.');return;}$('settingsFile').click();};$('settingsFile').onchange=async e=>{try{const file=e.target.files[0];if(!file)return;if(file.size>5000000)throw Error('Soubor se vzhledem je příliš velký.');const txt=await file.text();const match=txt.match(/\/\* ctecka-xml-settings:([A-Za-z0-9+/=\s]+) \*\//);if(!match)throw Error('Načíst lze CSS uložené touto čtečkou. Běžné CSS zatím automaticky nepřevádíme.');const raw=validateSettings(JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(match[1].replace(/\s/g,'')),c=>c.charCodeAt(0)))));let count=0;snapshot();settings.page={...raw.page};for(const f of fields)if(Object.hasOwn(raw.fields,f.key)){settings.fields[f.key]={...raw.fields[f.key]};count++;}syncPage();renderFields();syncEditor();renderPreview();tell('Vzhled načten: nastavení odpovídá '+count+' z '+fields.length+' cest tagů.');}catch(err){tell(err.message);}e.target.value='';};
$('prev').onclick=()=>{page--;renderPreview();};$('next').onclick=()=>{page++;renderPreview();};$('help').onclick=()=>$('helpDialog').showModal();$('closeHelp').onclick=()=>$('helpDialog').close();
let dragDepth=0;window.addEventListener('dragenter',e=>{if(e.dataTransfer.types.includes('Files')){e.preventDefault();dragDepth++;$('dropOverlay').hidden=false;}});window.addEventListener('dragover',e=>e.preventDefault());window.addEventListener('dragleave',()=>{dragDepth--;if(dragDepth<=0)$('dropOverlay').hidden=true;});window.addEventListener('drop',e=>{e.preventDefault();dragDepth=0;$('dropOverlay').hidden=true;readFile(e.dataTransfer.files[0]);});
